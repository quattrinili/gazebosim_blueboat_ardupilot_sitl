<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="blueboat_with_tags">
    
    <!-- 1. Include the Blueboat model -->
    <include merge="true">
      <uri>model://blueboat_wind</uri>
    </include>

    <!-- 2. Include Upper AprilTag -->
    <include>
      <uri>model://tag36_11_00000</uri>
      <name>tag_upper</name>
      <pose>0.27 0 0.19 1.57079632679 0 1.57079632679</pose>
    </include>

    <!-- 3. Include Lower AprilTag -->
    <include>
      <uri>model://tag16_05_00000</uri>
      <name>tag_lower</name>
      <pose>0.3 0 -0.06 1.57079632679 0 1.57079632679</pose>
    </include>

    <!-- 4. Rigorously attach the tags to the blueboat's base_link -->
    <joint name="tag_upper_joint" type="fixed">
      <parent>base_link</parent>
      <child>tag_upper::tag36_link</child>
    </joint>

    <joint name="tag_lower_joint" type="fixed">
      <parent>base_link</parent>
      <child>tag_lower::tag16_link</child>
    </joint>

    <joint name="plate_joint" type="fixed">
      <parent>base_link</parent>
      <child>plate_link</child>
    </joint>

    <!-- Target element the ASV magnet couples with -->
    <link name="plate_link">
      <pose>0.32 0 -0.12 0 0 0</pose> <!-- Rotated facing the approaching ASV -->
      <collision name="plate_collision">
        <geometry>
          <box>
            <size>0.01 0.129 0.03</size> <!-- Thickness (X), Width 129mm (Y), Height (Z) -->
          </box>
        </geometry>
      </collision>
      <visual name="plate_visual">
        <geometry>
          <box>
            <size>0.01 0.129 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.1 1</ambient>
          <diffuse>0.1 0.8 0.1 1</diffuse>
        </material> <!-- Green target plate -->
      </visual>
    </link>

    <joint name="guide_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>guide_left_link</child>
    </joint>

    <link name="guide_left_link">
      <!-- Angled to meet pontoon tip at X=0.59, Y=0.285 with zero gap -->
      <pose>0.455 0.182 -0.09 0 0 0.654</pose> 
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="guide_left_collision">
        <geometry>
          <box>
            <size>0.34 0.015 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu> <!-- Low friction for smooth sliding into dock -->
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="guide_left_visual">
        <geometry>
          <box>
            <size>0.34 0.015 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material> <!-- Metallic Grey Guide Rail -->
      </visual>
    </link>

    <joint name="guide_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>guide_right_link</child>
    </joint>

    <link name="guide_right_link">
      <!-- Angled to meet pontoon tip at X=0.59, Y=-0.285 with zero gap -->
      <pose>0.455 -0.182 -0.09 0 0 -0.654</pose> 
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="guide_right_collision">
        <geometry>
          <box>
            <size>0.34 0.015 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="guide_right_visual">
        <geometry>
          <box>
            <size>0.34 0.015 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>

      <publish_nested_model_pose>true</publish_nested_model_pose> 
      
      <publish_sensor_pose>true</publish_sensor_pose> 
      
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </model>
</sdf>

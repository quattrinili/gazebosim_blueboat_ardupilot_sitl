<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="tag16_05_00000">
    <static>false</static>
    <link name="tag16_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>

      <!-- 1. Solid White Backing Body (Sides and Rear) -->
      <visual name="visual_body">
        <geometry>
          <box>
            <size>0.048 0.048 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- 2. Textured Front Face (Plane offset slightly above +Z surface to prevent z-fighting) -->
      <visual name="visual_tag_face">
        <!-- Box thickness is 0.001m (top surface at z=+0.0005m). 
             Offset plane to z=0.00051m to sit on top of the face -->
        <pose>0 0 0.00051 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.048 0.048</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/tag16_05_00000.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- <collision name="collision">
        <geometry>
          <box>
            <size>0.048 0.048 0.001</size>
          </box>
        </geometry>
      </collision> -->
    </link>
  </model>
</sdf>

<sdf version="1.9">
  <model name="smallboat">
    <link name="base_link">
      <inertial>
        <!-- Scaled pose (-0.05*0.2, 0, -0.15*0.2) -->
        <pose>-0.01 0 -0.03 0 0 0</pose>
        <!-- Mass scaled by 0.008 (30.0 * 0.008) -->
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0242369</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.039235025</iyy>
          <iyz>0</iyz>
          <izz>0.056403125</izz>
        </inertia>
      </inertial>
      
      <collision name="hull_collision">
      <!--
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull_collision.stl</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      -->
        <pose>0 0 -0.05 0 0 0</pose> 
        <geometry>
          <box>
            <!-- A much smaller volume to prevent the beach-ball bouncing effect -->
            <size>0.5 0.3 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="hull_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hull.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>1 0 1 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="aerial_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_aerial.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="crosstube_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_crosstube.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="flag_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_flag.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 0 1</diffuse>
          <ambient>1 1 0 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="frame_asm_fore_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_fore.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="frame_asm_aft_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_frame_asm_aft.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.9</metalness>
              <roughness>0.1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="hatch_asm_stbd">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hatch_asm_stbd.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="hatch_asm_port">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_hatch_asm_port.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="motor_stbd_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_motor_stbd.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="motor_port_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_motor_port.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- Starboard Motor Link -->
    <link name="motor_stbd_link">
      <pose degrees="true">-0.0976 -0.059 -0.0544 -90 0 90</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <!-- <collision name="prop_collision">
        <geometry>

          <mesh>
            <uri>models://blueboat/meshes/blueboat_prop_stbd.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>

          <box>
            <size>0.02 0.02 0.01</size>
          </box>
        </geometry>
      </collision> -->
      <visual name="prop_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_prop_stbd.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="motor_stbd_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor_stbd_link</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0002</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Port Motor Link -->
    <link name="motor_port_link">
      <pose degrees="true">-0.0976 0.059 -0.0544 -90 0 90</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <!-- <collision name="prop_collision">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_prop_port.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
          <box>
            <size>0.02 0.02 0.01</size>
          </box>
        </geometry>
      </collision> -->
      <visual name="prop_visual">
        <geometry>
          <mesh>
            <uri>models://blueboat/meshes/blueboat_prop_port.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="motor_port_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor_port_link</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0002</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Sensors -->
    <link name="imu_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="revolute">
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- NavSat -->
    <link name="navsat_link">
      <pose>0 0 0.01 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="navsat_sensor" type="navsat">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1.0</update_rate>
        <topic>smallboat/navsat</topic>
        <!-- <gps>
          <fix>
            <service>1</service>
            <status>0</status>
          </fix>
        </gps> -->
      </sensor>
    </link>
    <joint name="navsat_joint" type="fixed">
      <parent>imu_link</parent>
      <child>navsat_link</child>
    </joint>

    <include>
      <uri>model://camera_imx219_stereo</uri>
      <name>stereo_camera</name>
      <!-- Placed slightly forward (X=0.05) and elevated (Z=0.1) on the boat -->
      <pose>0.05 0 0.1 0 0 0</pose>
    </include>
    <joint name="stereo_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>stereo_camera::link</child>
    </joint>
    <!-- ============================================== -->

    <!-- Plugins -->
    <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
    </plugin>
    <plugin name="gz::sim::systems::OdometryPublisher"
      filename="gz-sim-odometry-publisher-system">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <!-- Left Motor Thruster -->
    <plugin name="gz::sim::systems::Thruster"
      filename="gz-sim-thruster-system">
      <namespace>smallboat</namespace>
      <joint_name>motor_port_joint</joint_name>
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.0224</propeller_diameter>
      <velocity_control>0</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>

    <!-- Right Motor Thruster -->
    <plugin name="gz::sim::systems::Thruster"
      filename="gz-sim-thruster-system">
      <namespace>smallboat</namespace>
      <joint_name>motor_stbd_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.0224</propeller_diameter>
      <velocity_control>0</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>

    <!-- Hydrodynamics plugin -->
    <plugin name="gz::sim::systems::Hydrodynamics" 
        filename="gz-waves1-hydrodynamics-system">
        <enable>smallboat::base_link</enable>
        <hydrodynamics>
          <damping_on>1</damping_on>
          <viscous_drag_on>1</viscous_drag_on>
          <pressure_drag_on>1</pressure_drag_on>
        </hydrodynamics>
    </plugin>

    <!-- ArduPilot plugin -->
    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9012</fdm_port_in>         
      <fdm_port_out>9013</fdm_port_out>     
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>imu_link::imu_sensor</imuName>

      <control channel="0">
        <jointName>motor_port_joint</jointName>
        <multiplier>7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/smallboat/joint/motor_port_joint/cmd_thrust</cmd_topic>
      </control>

      <control channel="2">
        <jointName>motor_stbd_joint</jointName>
        <multiplier>7</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/smallboat/joint/motor_stbd_joint/cmd_thrust</cmd_topic>
      </control>
    </plugin>

    <!-- magnet -->
      <joint name="magnet_joint" type="fixed">
        <parent>base_link</parent>
        <child>magnet_link</child>
      </joint>

      <!-- Separate, Low-Mass Magnet Link -->
      <!-- Positioned at the very front bow of the ASV -->
      <link name="magnet_link">
        <pose>0.15 0 0.00 0 0 0</pose> 
        <inertial>
          <mass>0.1</mass> <!-- Small, isolated mass -->
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="magnet_collision">
          <geometry><cylinder><radius>0.03</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="magnet_visual">
          <geometry><cylinder><radius>0.03</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material> <!-- Red magnet -->
        </visual>
      </link>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>magnet_link</parent_link>
      <child_model>blueboat</child_model>
      <child_link>plate_link</child_link>
      <!-- <topic>/smallboat/magnet_control</topic> 1 to lock/dock, 0 to unlock/undock -->
      <attach_topic>/smallboat/magnet/attach</attach_topic>
      <detach_topic>/smallboat/magnet/detach</detach_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </model>
</sdf>